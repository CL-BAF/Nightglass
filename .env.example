# honeywatch environment variables — reference / example.
#
# Copy to .env (which is gitignored) or export the variables in your shell.
# honeywatch reads these to override config defaults; the TOML config file
# (HONEYWATCH_CONFIG or ./config.toml) takes precedence over these.

# API key for Ollama Cloud (https://ollama.com/v1).
# Cloud models only. A key is REQUIRED — create one at https://ollama.com/settings/keys
OLLAMA_API_KEY=

# Override the default AI model (default: llama3.1:8b).
# Example: HONEYWATCH_MODEL=llama3.2:3b
HONEYWATCH_MODEL=

# Path to a honeywatch TOML configuration file.
# If unset, honeywatch looks for ./config.toml, then falls back to built-in defaults.
# Example: HONEYWATCH_CONFIG=/etc/honeywatch/config.toml
HONEYWATCH_CONFIG=

# Skip the Mullvad VPN gate (offline/controlled testing only).
# Equivalent to --skip-vpn-check. Default: unset (gate enforced).
HONEYWATCH_SKIP_VPN=
